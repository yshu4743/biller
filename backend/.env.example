PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/biller?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Optional: use your own credentials for the auto-created admin (default: admin@biller.com / admin123)
ADMIN_EMAIL=admin@biller.com
ADMIN_PASSWORD=admin123